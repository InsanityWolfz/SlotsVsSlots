    "package:demo": "node package.cjs demo"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "productName": "Reel Brawl"
}
